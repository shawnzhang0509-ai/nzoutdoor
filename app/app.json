{
  "expo": {
    "name": "NZ Outdoor",
    "slug": "nz-outdoor",
    "scheme": "nzoutdoor",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "nz.co.nzoutdoor.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "\u7528\u4e8e\u663e\u793a\u9644\u8fd1\u6237\u5916\u5730\u70b9\u4e0e\u5230\u573a Check-in"
      }
    },
    "android": {
      "package": "nz.co.nzoutdoor.app",
      "permissions": [
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}